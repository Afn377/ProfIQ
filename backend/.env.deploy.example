# Copy this file to backend/.env.deploy and fill in real values.
# backend/.env.deploy is gitignored — never commit real secrets.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# CockroachDB Serverless — see https://www.cockroachlabs.com/docs/cockroachcloud
# Download the cluster's CA cert from the CockroachDB Cloud console into
# backend/certs/cockroachdb-ca.crt (public cert, safe to commit) before deploying,
# or set DB_SSLROOTCERT below to point elsewhere.
USE_POSTGRES=1
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=26257
DB_SSLROOTCERT=

# CORS — comma-separated list of allowed frontend origins.
# Add the Vercel URL after the frontend's first deploy, and profiq.smafnanhaider.com once DNS is live.
CORS_EXTRA_ORIGINS=https://profiq.smafnanhaider.com

# Google Cloud Run
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=profiq-backend

# Frontend build — set to the Cloud Run service URL PLUS /api, e.g. https://profiq-backend-xxxx.run.app/api (after the first backend deploy)
VITE_API_BASE_URL=
